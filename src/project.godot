; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="The Drawdown Protocol"
config/description="Rogue-lite climate strategy prototype. One run = 15 turns, 2030-2100: a race to bend the curve before the climate clock hits the tipping point."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8")

[autoload]

Meta="*res://scripts/meta_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

