; Engine configuration file.
config_version=5

[application]

config/name="The Drawdown Protocol"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Game="*res://scripts/autoload/game.gd"

[display]

